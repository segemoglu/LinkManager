@using LinkManager.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="alert alert-danger m-4">
                        <h4>⛔ Yetkisiz Giriş</h4>
                        <p>Bu sayfayı görmeye yetkiniz yok. Lütfen giriş yapın.</p>
                        <a href="/login" class="btn btn-danger btn-sm">Giriş Yap</a>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <PageTitle>Sayfa Bulunamadı</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="alert alert-warning m-4">
                    <p role="alert">Aradığınız sayfa bulunamadı.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>

</CascadingAuthenticationState>