@page "/"
@using MediatR
@using LinkManager.Domain
@using LinkManager.Feature.Links.Queries
@using LinkManager.Feature.Links.Commands
@using Microsoft.AspNetCore.Components.Authorization
@inject IMediator Mediator
@inject IJSRuntime JS

<PageTitle>Ferre Link Manager</PageTitle>

<div class="container-fluid">
    <div class="row mb-4 justify-content-center">
        <div class="col-md-8">
            <div class="input-group input-group-lg shadow-sm">
                <span class="input-group-text bg-white border-0"><i class="fa-solid fa-search text-muted"></i>🔍</span>
                <input type="text" class="form-control border-0"
                       placeholder="Link adı, kategori veya açıklama ara..."
                       @bind="AramaMetni" @bind:event="oninput" />

                <AuthorizeView>
                    <Authorized>
                        <a href="/link-ekle" class="btn btn-primary px-4 d-flex align-items-center">
                            <span class="fs-5 me-2">+</span> Ekle
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>

    @if (TumLinkler == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Linkler yükleniyor...</p>
        </div>
    }
    else
    {
        <div class="row px-3">
            @foreach (var link in FiltreliLinkler)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 modern-card shadow-sm border-0 position-relative overflow-hidden" style="--kart-rengi: @link.ColorClass;">

                        <div class="card-top-accent"></div>

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="fw-bolder m-0 text-dark card-title-text d-flex align-items-center gap-3" style="letter-spacing: -0.5px;">
                                    <div class="icon-box">
                                        <i class="@link.IconClass"></i>
                                    </div>
                                    @link.Title
                                </h5>
                                <span class="badge rounded-pill category-badge">@link.Category</span>
                            </div>

                            <div class="url-display mb-3 px-3 py-2 rounded-3 d-flex align-items-center gap-2" title="@link.Url">
                                <i class="fa-solid fa-globe text-muted" style="font-size: 0.85rem;"></i>
                                <span class="text-truncate url-text">
                                    @link.Url
                                </span>
                            </div>

                            <p class="text-muted small flex-grow-1" style="line-height: 1.6;">@link.Description</p>
                        </div>

                        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex gap-2">
                            <a href="@(link.Url.StartsWith("http") ? link.Url : $"http://{link.Url}")" target="_blank" class="btn btn-visit btn-sm flex-grow-1 fw-bold rounded-3">
                                Ziyaret Et <i class="fa-solid fa-arrow-up-right-from-square ms-1" style="font-size: 0.75rem;"></i>
                            </a>
                            <AuthorizeView>
                                <Authorized>
                                    <a href="/link-duzenle/@link.Id" class="btn btn-light btn-sm border rounded-3 text-secondary"><i class="fa-solid fa-pen"></i></a>
                                    <button @onclick="() => Sil(link)" class="btn btn-light btn-sm border text-danger rounded-3"><i class="fa-solid fa-trash"></i></button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!FiltreliLinkler.Any() && TumLinkler.Any())
        {
            <div class="text-center mt-5 text-muted">
                <h4>🤷‍♂️ Sonuç bulunamadı</h4>
                <p>"@AramaMetni" için başka bir şey deneyin.</p>
            </div>
        }
    }
</div>

<style>
    /* Kart Hover Efekti */
    .card:hover {
        transform: translateY(-7px) scale(1.01);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
    }

    /* Arama Kutusu Odaklanma */
    .form-control:focus {
        box-shadow: none;
    }

    .input-group:focus-within {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }



    /* Kartın Genel Yapısı ve Animasyonu */
    .modern-card {
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        background: #ffffff;
    }

        .modern-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08) !important;
        }

    /* Üstteki Modern Renk Geçişi (Gradyan) */
    .card-top-accent {
        height: 5px;
        width: 100%;
        background: linear-gradient(90deg, var(--kart-rengi), color-mix(in srgb, var(--kart-rengi) 30%, white));
        position: absolute;
        top: 0;
        left: 0;
    }

    /* İkon Kutucuğu (Hafif Şeffaf Arka Plan) */
    .icon-box {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        background-color: color-mix(in srgb, var(--kart-rengi) 12%, transparent);
        color: var(--kart-rengi);
    }

    /* Kategori Rozeti */
    .category-badge {
        background-color: var(--kart-rengi);
        color: white;
        font-weight: 500;
        padding: 0.4em 0.8em;
    }

    /* URL / IP Gösterim Alanı */
    .url-display {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .url-text {
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        color: #475569;
        font-weight: 600;
    }

    /* Dinamik Renkli Buton */
    .btn-visit {
        background-color: var(--kart-rengi);
        color: white;
        border: none;
        transition: filter 0.2s;
    }

        .btn-visit:hover {
            filter: brightness(1.1); /* Üzerine gelince rengi parlar */
            color: white;
        }

    /* === DARK MODE UYUMLULUĞU === */
    .dark-theme .modern-card {
        background: #1e293b !important;
        border: 1px solid #334155 !important;
    }

    .dark-theme .card-title-text {
        color: #f8fafc !important;
    }

    .dark-theme .url-display {
        background-color: #0f172a !important;
        border-color: #334155 !important;
    }

    .dark-theme .url-text {
        color: #94a3b8 !important;
    }

    .dark-theme .btn-light {
        background-color: #334155 !important;
        border-color: #475569 !important;
        color: #cbd5e1 !important;
    }
</style>

@code {
    private List<LinkItem>? TumLinkler;
    private string AramaMetni { get; set; } = "";

    private IEnumerable<LinkItem> FiltreliLinkler =>
        string.IsNullOrWhiteSpace(AramaMetni)
            ? TumLinkler ?? new List<LinkItem>()
            : TumLinkler.Where(l =>
                l.Title.Contains(AramaMetni, StringComparison.OrdinalIgnoreCase) ||
                l.Category.Contains(AramaMetni, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        TumLinkler = await Mediator.Send(new GetLinksQuery());
    }

    private async Task Sil(LinkItem link)
    {
        // 1. Artık kendi yazdığımız JS fonksiyonunu çağırıyoruz
        bool onay = await JS.InvokeAsync<bool>("showDeleteConfirmation", link.Title);

        if (onay)
        {
            // 2. Veritabanından sil
            await Mediator.Send(new DeleteLinkCommand(link.Id));

            // 3. Ekrandan sil
            TumLinkler.Remove(link);

            // 4. Sağ üstte şık bir başarı bildirimi göster! (Opsiyonel ama çok havalı)
            await JS.InvokeVoidAsync("showSuccessAlert", "Link başarıyla silindi!");

            // Ekranı güncellemek için
            StateHasChanged();
        }
    }
}