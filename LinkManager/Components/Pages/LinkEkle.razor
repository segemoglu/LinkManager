@page "/link-ekle"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MediatR
@using LinkManager.Feature.Links.Commands
@inject IMediator Mediator
@inject NavigationManager NavManager

<div class="card p-4 shadow-lg mx-auto mt-5 border-0" style="max-width: 600px; border-radius: 12px;">

    <h3 class="text-center mb-4 fw-bold text-primary">🎨 Yeni Link Ekle</h3>

    <EditForm Model="@Model" OnValidSubmit="Kaydet">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="fw-bold text-secondary mb-1">Başlık</label>
            <InputText @bind-Value="Model.Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="fw-bold text-secondary mb-1">URL</label>
            <InputText @bind-Value="Model.Url" class="form-control" placeholder="http://..." />
        </div>

        <div class="mb-3">
            <label class="fw-bold text-secondary mb-1">Kategori</label>
            <InputText @bind-Value="Model.Category" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="fw-bold mb-1">İkon (FontAwesome)</label>
            <div class="input-group">
                <span class="input-group-text"><i class="@Model.IconClass"></i></span>
                <InputText @bind-Value="Model.IconClass" class="form-control" placeholder="Örn: fa-solid fa-house" />
            </div>
            <small class="text-muted">İkon kodlarını <a href="https://fontawesome.com/search?o=r&m=free" target="_blank">buradan</a> bulabilirsiniz.</small>
        </div>

        <div class="mb-3">
            <label class="fw-bold text-secondary mb-1">Kart Rengi</label>
            <InputSelect @bind-Value="Model.ColorClass" class="form-select">
                @foreach (var renk in Renkler)
                {
                    <option value="@renk.Value">@renk.Key</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="fw-bold text-secondary mb-1">Açıklama</label>
            <InputTextArea @bind-Value="Model.Description" class="form-control" rows="3" />
        </div>

        <button type="submit" class="btn btn-success w-100 btn-lg shadow-sm">💾 Kaydet</button>
        <a href="/" class="btn btn-secondary w-100 mt-2">İptal</a>
    </EditForm>
</div>

@code {
    private CreateLinkCommand Model = new CreateLinkCommand();

    private Dictionary<string, string> Renkler = new Dictionary<string, string>
    {
        { "Gece Mavisi", "#2c3e50" },
        { "Okyanus", "#2980b9" },
        { "Zümrüt Yeşili", "#27ae60" },
        { "Vişne Çürüğü", "#c0392b" },
        { "Turuncu", "#d35400" },
        { "Mor (Amethyst)", "#8e44ad" },
        { "Asfalt Gri", "#34495e" },
        { "Çivit Mavisi", "#3f51b5" },
        { "Orman Yeşili", "#1b5e20" },
        { "Koyu Kırmızı", "#b71c1c" },
        { "Hardal", "#f57f17" },
        { "Patlıcan Moru", "#4a148c" },
        { "Petrol Mavisi", "#006064" },
        { "Çikolata", "#3e2723" },
        { "Siyah", "#000000" },
        { "Barut Rengi", "#37474f" },
        { "Ahududu", "#880e4f" },
        { "Zeytin", "#33691e" }
    };

    private async Task Kaydet()
    {
        await Mediator.Send(Model);
        NavManager.NavigateTo("/");
    }
}