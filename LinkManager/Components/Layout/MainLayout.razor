@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page-wrapper @(IsDarkMode ? "dark-theme" : "light-theme")">

    @* Sitenin en arka planı olan body etiketini karanlık moda zorluyoruz *@
    @if (IsDarkMode)
    {
        <style>
            body {
                background-color: #0f172a !important;
                background-image: none !important;
            }
        </style>
    }

    <main>
        <nav class="modern-topbar px-4 py-3">
            <div class="d-flex align-items-center">
                <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
                    <img src="/images/logo.png" alt="Ferre Logo" class="company-logo" />
                    <span class="logo-highlight logo-text">LINK MANAGER</span>
                </a>
            </div>

            <div class="user-actions">

                <button class="btn btn-theme-toggle shadow-sm" @onclick="ToggleTheme" title="Temayı Değiştir">
                    <i class="fa-solid @(IsDarkMode ? "fa-sun text-warning" : "fa-moon text-secondary") fs-5"></i>
                </button>

                <AuthorizeView>
                    <Authorized>
                        <div class="user-badge d-none d-md-flex">
                            <div class="avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="fw-medium">@context.User.Identity?.Name</span>
                        </div>
                        <a href="/account/logout" class="btn btn-modern-danger">Çıkış Yap</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-modern-primary">Yönetici Girişi</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </nav>

        <article class="content px-4 py-5">
            @Body
        </article>
    </main>
</div>

<style>
    /* ==========================================
               1. STANDART (AYDINLIK) TEMA STİLLERİ
               ========================================== */
    body {
        background-color: #f8fafc;
        background-image: radial-gradient(at 0% 0%, hsla(210, 100%, 97%, 1) 0, transparent 50%), radial-gradient(at 100% 100%, hsla(210, 100%, 95%, 1) 0, transparent 50%);
        background-attachment: fixed;
        font-family: 'Inter', sans-serif;
        margin: 0;
        transition: background-color 0.3s ease;
    }

    .content {
        max-width: 1400px;
        margin: 0 auto;
    }

    .modern-topbar {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 1000;
        transition: all 0.3s ease;
    }

    /* Şirket Logosu Ayarı */
    .company-logo {
        height: 34px; /* Logoyu bir tık daha kibar ve orantılı yaptık */
        width: auto;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

        .company-logo:hover {
            transform: scale(1.05);
        }

    /* Yanındaki Yazı Ayarı */
    .logo-text {
        font-size: 2.30rem; /* Logoyla ezilmemesi için biraz ufaltıldı */
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #1e293b;
        transition: color 0.3s;
        line-height: 1; /* Yazının etrafındaki gizli boşluğu sildik */
        margin-top: 5px; /* Optik olarak logoyla tam orta hizaya çektik */
    }
    
    .user-actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .user-badge {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #475569;
        transition: color 0.3s;
    }

    .avatar {
        background: #e2e8f0;
        color: #64748b;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: all 0.3s;
    }

    /* Tema Butonu Tasarımı */
    .btn-theme-toggle {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        padding: 0;
    }

        .btn-theme-toggle:hover {
            transform: scale(1.05);
            background: #f8fafc;
        }

    .btn-modern-primary {
        background: #2563eb;
        color: white;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        border: none;
        transition: all 0.2s;
    }

        .btn-modern-primary:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
            color: white;
        }

    .btn-modern-danger {
        background: #fef2f2;
        color: #ef4444;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #fee2e2;
        transition: all 0.2s;
    }

        .btn-modern-danger:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    /* ==========================================
               2. DARK MODE (KARANLIK TEMA) KÜRESEL EZİCİLER
               Bu CSS sınıfları diğer sayfalardaki beyaz Bootstrap kodlarını ezer.
               ========================================== */
    .dark-theme .modern-topbar {
        background: rgba(15, 23, 42, 0.85);
        border-bottom: 1px solid rgba(51, 65, 85, 0.8);
    }

    .dark-theme .logo-text {
        color: #f8fafc;
    }

    .dark-theme .user-badge {
        color: #cbd5e1;
    }

    .dark-theme .avatar {
        background: #334155;
        color: #94a3b8;
    }

    .dark-theme .btn-theme-toggle {
        background: #1e293b;
        border-color: #334155;
    }

        .dark-theme .btn-theme-toggle:hover {
            background: #334155;
        }

    /* Diğer Sayfalar (Home, Ekle, Düzenle) İçin Ortak Dark Mode Eziciler */
    .dark-theme .card,
    .dark-theme .bg-white {
        background-color: #1e293b !important; /* Satır içi background:white stilini bile ezer */
        color: #f8fafc !important;
        border-color: #334155 !important;
    }

    .dark-theme .text-dark {
        color: #f8fafc !important;
    }

    .dark-theme .text-muted {
        color: #94a3b8 !important;
    }

    /* Form Elemanları (Input, Select, Textarea) */
    .dark-theme .form-control,
    .dark-theme .form-select {
        background-color: #0f172a !important;
        border-color: #334155 !important;
        color: #f8fafc !important;
    }

        .dark-theme .form-control:focus,
        .dark-theme .form-select:focus {
            background-color: #0f172a !important;
            border-color: #3b82f6 !important;
            color: #ffffff !important;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25) !important;
        }

    .dark-theme .input-group-text {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #cbd5e1 !important;
    }


    /* Kartların altındaki butonları Dark Mode'da düzeltir */
    .dark-theme .card-footer .btn {
        background-color: #3b82f6 !important; /* Modern mavi */
        color: #ffffff !important;
        border: none !important;
    }

        .dark-theme .card-footer .btn:hover {
            background-color: #2563eb !important;
        }
</style>

@code {
    private bool IsDarkMode = false;

    private void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
    }
}